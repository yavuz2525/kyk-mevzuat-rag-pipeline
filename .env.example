# LLM & Embedding API Keys
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional cost display configuration (USD per 1M tokens)
DEEPSEEK_INPUT_PRICE_PER_M=0.14
DEEPSEEK_OUTPUT_PRICE_PER_M=0.28
# Leave blank to hide the approximate TRY conversion in Streamlit.
USD_TRY_RATE=

# Teable API Configuration
TEABLE_URL=http://localhost:3000
TEABLE_API_TOKEN=your_teable_access_token_here
TEABLE_TABLE_ID=your_teable_table_id_here

# OCR: 0 = process every page in 7.5.38510.pdf
OCR_MAX_PAGES=0
